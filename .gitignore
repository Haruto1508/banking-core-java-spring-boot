# ====================================================================
# Git Ignore - Core Banking System (Mono-repo: Backend & Frontend)
# ====================================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp

# Secrets & Environment Files
.env
*.env
*.env.local
*.env.*.local
!.env.example
!backend/.env.example

# ====================================================================
# Java & Gradle (Root & Backend)
# ====================================================================
.gradle/
backend/.gradle/
build/
backend/build/
backend/**/build/
bin/
out/

# Compiled Java class files
*.class

# Package Files (except Gradle wrapper jar)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar
!backend/gradle/wrapper/gradle-wrapper.jar

# ====================================================================
# IDE & Editors
# ====================================================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.run/
cmake-build-*/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/load-impl.xml
/nbproject/build-impl.xml

# ====================================================================
# Database & Docker Volumes
# ====================================================================
postgres_data/
.docker-data/
*.sql.gz
*.dump

# ====================================================================
# Frontend (React / Vue / Next.js / Node.js)
# ====================================================================
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.next/
frontend/.next/
coverage/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
