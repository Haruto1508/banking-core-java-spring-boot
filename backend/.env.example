# ====================================================================
# Core Banking System - Environment Variables Template
# Copy this file to .env and adjust values for your local environment.
# NEVER commit your actual .env file with production secrets!
# ====================================================================

# Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database
DB_URL=jdbc:postgresql://localhost:5432/core_banking
DB_USERNAME=banking_admin
DB_PASSWORD=banking_secret_password

# JWT Security (Minimum 256-bit / 32+ characters for HS256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Account Lockout Policy
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=15
